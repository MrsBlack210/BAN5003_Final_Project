# Copy this file to .env and fill in your own Postgres details.
# Only needed for Path A (loading the data from Postgres).
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE
# If your Postgres has no password for your user, leave out ":PASSWORD".
DATABASE_URL=postgresql+psycopg2://your_user:your_password@localhost:5432/BAN5003
